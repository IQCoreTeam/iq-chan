# NEXT_PUBLIC_* values are inlined into the client bundle at build time
# and are visible to anyone in the browser — do not treat them as secrets.
NEXT_PUBLIC_RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
NEXT_PUBLIC_GATEWAY_URL=https://gateway.iqlabs.dev

# Optional Jupiter referral account (not a wallet address). Create and verify the
# account and fee-token accounts first; see docs/qa/solana-tranches/README.md.
# Enables a 1.25% total referral fee. Leave unset for normal Jupiter fees.
NEXT_PUBLIC_JUPITER_REFERRAL_ACCOUNT=
